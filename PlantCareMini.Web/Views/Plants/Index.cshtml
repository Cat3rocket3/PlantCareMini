@model IEnumerable<Plant>
@{ ViewData["Title"] = "Plants"; }
<section class="plant-section">
<h1>Plant catalog</h1>
<p><a class="btn btn-primary" asp-action="Create">Add plant</a></p>
<form method="get" asp-action="Index" class="filters">
    <div class="filter-field">
    <label for="search">Name</label>
    <input class="form-control" id="search" name="search" value="@ViewBag.Search" />
    </div>
    <div class="filter-field">
    <label for="growingLocationId">Growing location</label>
    <select class="form-select" id="growingLocationId" name="growingLocationId">
        <option value="">All locations</option>
        @foreach (GrowingLocation location in ViewBag.GrowingLocations)
        {
            <option value="@location.GrowingLocationId" selected="@(ViewBag.GrowingLocationId == location.GrowingLocationId)">@location.Name</option>
        }
    </select>
    </div>
    <button class="btn btn-primary" type="submit">Search</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
</form>
@if (!Model.Any())
{
    <p>No plants found.</p>
}
else
{
    <div class="table-scroll"><table class="table table-striped">
        <thead><tr><th>Name</th><th>Type</th><th>Location</th><th>Watering (days)</th><th>Actions</th></tr></thead>
        <tbody>
        @foreach (var plant in Model)
        {
            <tr>
                <td>@plant.Name</td><td>@plant.PlantType.Name</td><td>@plant.GrowingLocation.Name</td><td>@plant.WateringIntervalDays</td>
                <td class="plant-actions"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@plant.PlantId">Details</a> <a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@plant.PlantId">Edit</a> <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@plant.PlantId">Delete</a></td>
            </tr>
        }
        </tbody>
    </table></div>
}

</section>
